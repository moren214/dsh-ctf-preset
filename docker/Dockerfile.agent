# DSH CTF Autonomous Competition Agent Image (dsh-ctf-agent:latest)
# Build from repository root:
#   docker build -f docker/Dockerfile.agent -t dsh-ctf-agent:latest .
# Run challenge headless:
#   docker run --rm -v "$PWD:/work" -e OPENAI_API_KEY=... dsh-ctf-agent:latest --challenge /work --output /work/result.json
ARG BASE_IMAGE=dsh-ctf-sandbox:latest
FROM ${BASE_IMAGE}
USER root

ARG NODE_VERSION=24.21.0
ARG NODE_SHA256_AMD64=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6
ARG NODE_SHA256_ARM64=6ad1325edbdb5649c379b75a237147a666c95d4f9ae8d340fef2d1575d289ad2
ARG NODE_BASE_URL=https://nodejs.org/dist

RUN ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
        amd64) NODE_ARCH="x64"; NODE_SHA256="$NODE_SHA256_AMD64" ;; \
        arm64) NODE_ARCH="arm64"; NODE_SHA256="$NODE_SHA256_ARM64" ;; \
        *) echo "Unsupported architecture for Node.js: $ARCH" >&2; exit 2 ;; \
    esac \
    && curl -fsSL "${NODE_BASE_URL}/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" -o /tmp/node.tar.xz \
    && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c - \
    && mkdir -p /opt/nodejs \
    && tar -xJf /tmp/node.tar.xz -C /opt/nodejs --strip-components=1 \
    && ln -sf /opt/nodejs/bin/node /usr/local/bin/node \
    && ln -sf /opt/nodejs/bin/npm /usr/local/bin/npm \
    && rm -f /tmp/node.tar.xz \
    && node --version

WORKDIR /opt/ctf-agent
COPY package.json ./
COPY core/ ./core/
COPY dsh-adapter/ ./dsh-adapter/
COPY presets/ ./presets/
COPY runner/ ./runner/
COPY skills/ ./skills/
COPY locale/ ./locale/
COPY *.js *.py ./

RUN chown -R 10001:10001 /opt/ctf-agent

ENV NODE_ENV=production \
    CTF_SANDBOX_BACKEND=local \
    CTF_CHALLENGE_DIR=/work

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:8080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

WORKDIR /work
USER 10001:10001
ENTRYPOINT ["node", "/opt/ctf-agent/runner/cli.js"]
