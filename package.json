{
  "name": "@local/dsh-ctf-preset",
  "version": "0.37.1",
  "private": true,
  "description": "All-purpose CTF preset with shell, web, subagents and resumable progress for DeepSeek Harness",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "scripts": {
    "check": "node scripts/check-modules.mjs",
    "test": "node --test test/*.test.js",
    "test:coverage": "node scripts/check-coverage.mjs"
  },
  "exports": {
    ".": "./ctf-tools.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
