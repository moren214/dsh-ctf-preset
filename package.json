{
  "name": "@local/dsh-ctf-preset",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable CTF Core Runtime with Dual Presets (Copilot & Autonomous) and Headless Runner for DeepSeek Harness",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "scripts": {
    "check": "node scripts/check-modules.mjs",
    "test": "node --test test/*.test.js",
    "test:coverage": "node scripts/check-coverage.mjs",
    "test:python": "python -m unittest discover -s tests/python -v"
  },
  "exports": {
    ".": "./ctf-tools.js",
    "./core": "./core/index.js",
    "./copilot": "./presets/copilot/index.js",
    "./autonomous": "./presets/autonomous/index.js",
    "./runner": "./runner/cli.js",
    "./routing": "./core/routing/ctf-router.js",
    "./sandbox": "./core/sandbox/sandbox-runner.js",
    "./state": "./core/state/state-store.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "SKILL.md",
    "CHANGELOG.md",
    "locale/*.json",
    "icon.svg",
    "ctf-tools.js",
